---
import logoSvg from '../assets/logo.svg?raw';

const links = [
  { label: 'Discography', href: '/discography' },
  { label: 'About', href: '/about' },
  { label: 'Tablatures', href: '/tablatures' },
  { label: 'Tour', href: 'https://krallicetour.com', external: true },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

// the traced logo ships with viewBox only — size it to its container here
const logo = logoSvg.replace('<svg ', '<svg class="h-auto w-full" ');
---

<nav class="relative z-40 border-b border-stone-800/70 bg-black/40 backdrop-blur-sm">
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-4">
    <a
      href="/"
      class="font-display text-md uppercase tracking-[0.4em] text-stone-200 transition-colors hover:text-white"
    >
      Krallice
    </a>
    <ul class="hidden flex-wrap items-center gap-x-5 sm:flex sm:gap-x-8">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            class:list={[
              'text-[0.7rem] uppercase tracking-[0.25em] transition-colors',
              path === l.href
                ? 'text-stone-100 underline decoration-stone-500 underline-offset-[0.7em]'
                : 'text-stone-400 hover:text-stone-100',
            ]}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
    <button
      type="button"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Menu"
      class="block w-9 cursor-pointer text-stone-300 transition-colors hover:text-white sm:hidden"
      set:html={logo}
    />
  </div>
  <div
    id="mobile-nav"
    hidden
    class="absolute inset-x-0 top-full border-b border-stone-800/70 bg-black/80 backdrop-blur-sm sm:hidden"
  >
    <ul class="space-y-1 px-6 py-4">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            {...(l.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            class:list={[
              'block py-2 text-[0.75rem] uppercase tracking-[0.25em] transition-colors',
              path === l.href
                ? 'text-stone-100 underline decoration-stone-500 underline-offset-[0.7em]'
                : 'text-stone-400 hover:text-stone-100',
            ]}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.getElementById('mobile-nav');
  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      toggle.setAttribute('aria-expanded', String(open));
    };
    toggle.addEventListener('click', () => setOpen(!!panel.hidden));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
    document.addEventListener('click', (e) => {
      const t = e.target as Node;
      if (!panel.hidden && !panel.contains(t) && !toggle.contains(t)) setOpen(false);
    });
  }
</script>
