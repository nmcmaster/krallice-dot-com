---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSortedAlbums } from '../data/albums';

const albums = await getSortedAlbums();
---

<BaseLayout title="Krallice — Discography" description="The complete Krallice discography.">
  <main class="mx-auto max-w-5xl px-6 py-12 md:py-16">
    <h1 class="text-center font-display text-5xl font-medium text-stone-100 md:text-6xl">
      Discography
    </h1>
    <p class="mt-4 text-center text-xs uppercase tracking-[0.4em] text-stone-500">
      In chronological order
    </p>

    <ul class="mt-12 grid grid-cols-2 gap-5 sm:grid-cols-3 md:gap-7 lg:grid-cols-4">
      {albums.map((album) => (
        <li>
          <a href={`/albums/${album.id}`} class="group block">
            <div class="aspect-square overflow-hidden border border-stone-800 bg-stone-950">
              {album.data.coverArt ? (
                <img
                  src={album.data.coverArt}
                  alt={album.data.title}
                  loading="lazy"
                  class="h-full w-full object-cover opacity-90 transition duration-300 group-hover:opacity-100 motion-safe:group-hover:scale-[1.03]"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center p-3 text-center font-display text-stone-400">
                  {album.data.title}
                </div>
              )}
            </div>
            <div class="mt-3">
              <p class="font-display text-lg leading-tight text-stone-100 group-hover:text-white">
                {album.data.title}
              </p>
              <p class="font-mono text-xs tabular-nums text-stone-500">
                {album.data.releaseDate.getUTCFullYear()}
              </p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
